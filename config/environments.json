{
  "local": {
    "env": "local",
    "name": "本地开发调试环境 (Local Dev)",
    "description": "完全离线隔离的本地环境，无需运维依赖，静态资源、画廊、论坛与生图均在本地运行",
    "port": 3000,
    "host": "127.0.0.1",
    "base_url": "http://localhost:3000",
    "discourse_mode": "local",
    "discourse_url": "http://localhost:3000",
    "static_mode": "local",
    "static_url": "/studio/assets",
    "image_mode": "local",
    "image_url": "/images",
    "gallery_mode": "local",
    "gallery_url": "/gallery",
    "image_service_mode": "mock",
    "image_service_url": "http://127.0.0.1:8000",
    "storage_driver": "json",
    "storage_file": "ops/dev_data.json",
    "allow_mock_auth": true,
    "rate_limits_enabled": false,
    "offline_images": true
  },
  "production": {
    "env": "production",
    "name": "公网生产环境 (Production)",
    "description": "腾讯云生产服务器环境，依赖 PostgreSQL、Redis、Puma、Nginx 以及 Cloudflare CDN",
    "port": 3000,
    "host": "127.0.0.1",
    "base_url": "https://handraw-style.com",
    "discourse_mode": "remote",
    "discourse_url": "https://handraw-style.com",
    "static_mode": "cdn",
    "static_url": "https://static.handraw-style.com",
    "image_mode": "cdn",
    "image_url": "https://img.handraw-style.com/images",
    "gallery_mode": "cdn",
    "gallery_url": "https://static.handraw-style.com/gallery",
    "image_service_mode": "remote",
    "image_service_url": "https://chatgpt2api.handraw-style.com",
    "storage_driver": "postgresql",
    "storage_file": null,
    "allow_mock_auth": false,
    "rate_limits_enabled": true,
    "offline_images": false
  }
}
