# Server-only runtime configuration. Do not put real values in this file.
HANDRAW_PRIVATE_STORAGE=/home/yang0/handraw-data/private
HANDRAW_DISCOURSE_ROOT=/home/yang0/projectHome/discourse
HANDRAW_WEB_ROOT=/home/yang0/projectHome/handraw-web
HANDRAW_BASE_URL=https://handraw-style.com
HANDRAW_DATABASE_URL=
